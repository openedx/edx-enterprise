# pylintrc tweaks for use with edx_lint.
[MASTER]
ignore=migrations
load-plugins=edx_lint.pylint,pylint_django,pylint_celery
no-docstring-rgx=(__.*__)|Meta

[MESSAGES CONTROL]
disable+ =
    logging-format-interpolation,
    no-member,
    missing-timeout,
    use-yield-from,
    too-many-positional-arguments,

[PII]
# edx-lint 6.2.0+ requires this to be set or pylint crashes (pii-annotation-checker).
# Matches edx-lint's own shipped default.
pii-terms =
    email,
    username
